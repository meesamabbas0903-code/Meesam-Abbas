# ==================================================================
#  WhatsApp AI Chatbot — configuration
#  Copy to ".env"  →  cp .env.example .env
# ==================================================================

# ---------------------------- server ------------------------------
PORT=3000

# ------------------- WhatsApp (QR pairing) ------------------------
# The bot runs on whichever WhatsApp account you link by scanning the QR.
# Data isn't in env — the session is stored in data/auth after one scan.

# Your own number (digits only, with country code) for order + handover alerts.
# Leave blank to send alerts to the linked number itself.
OWNER_WHATSAPP_NUMBER=

# Customer shareable QR: blank = uses the linked number automatically.
CUSTOMER_NUMBER=
CUSTOMER_PREFILL=Hi, mujhe video editing chahiye

# Session storage (persists the login across restarts)
AUTH_DIR=data/auth

# Reply in group chats too?  on | off
REPLY_IN_GROUPS=off

# Baileys internal logging: silent | error | info | debug
BAILEYS_LOG=silent

# --------------------- AI BRAIN (GitHub Models) -------------------
# 1. github.com/settings/tokens  →  Fine-grained token
# 2. Permission: "Models" → Read-only  (classic PAT: no scopes needed)
# 3. Paste it below and restart. Free tier — no credit card.
# GITHUB_TOKEN is intentionally blank — paste your token in the dashboard Settings panel.

# Inference endpoint (OpenAI-compatible)
#   new / recommended : https://models.github.ai/inference
#   legacy (deprecated): https://models.inference.ai.azure.com
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# DeepSeek model id.
#   deepseek/deepseek-v3-0324  → fast, best for chat/sales replies (recommended)
#   deepseek/DeepSeek-R1       → reasoning model, slower, thinks before replying
#   deepseek/DeepSeek-R1-0528  → newer R1
AI_MODEL=deepseek/deepseek-v3-0324

# If the model above is unavailable on your account, these are tried in order.
AI_MODEL_FALLBACKS=deepseek/DeepSeek-R1,openai/gpt-4o-mini

# on = AI answers free-text questions, off = menu-only (no AI cost/limits)
AI_FALLBACK=on

AI_TEMPERATURE=0.45
AI_MAX_TOKENS=320
AI_TIMEOUT_MS=25000
AI_HISTORY_TURNS=8
# Max AI replies per customer session (cost/abuse control)
AI_MAX_MESSAGES_PER_SESSION=30

# Prompt file (editable, supports {{BUSINESS_NAME}}, {{OWNER_NAME}}, {{KNOWLEDGE}})
SYSTEM_PROMPT_FILE=prompts/system-prompt.md
